msgstr "Solo per amministratori"

msgid "Тільки для зареєстрованих користувачів"
msgstr "Solo per utenti registrati"

msgid "Тільки сайт без адмінки та heartbeat"
msgstr "Solo il sito, senza l'area amministrativa, e heartbeat"

