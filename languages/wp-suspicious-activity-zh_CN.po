msgstr "时间窗口"

msgid "Підозріла активність"
msgstr "可疑活动"

msgid "Результатів запиту:"
msgstr "查询结果："

msgid "Ризик"
msgstr "风险"

msgid "Розрив (користувач вийшов)"
msgstr "间隔（用户已离开）"

msgid "Розрив: %s"
msgstr "间隔：%s"

msgid "Розривів > 5 хв"
msgstr "超过 5 分钟的间隔"

msgid "Середній"
msgstr "中等"

msgid "Сесій"
msgstr "会话数"

msgid "Сесій: %d | Розривів > 5 хв: %d"
msgstr "会话数：%d | 超过 5 分钟的间隔：%d"

msgid "Скинути"
msgstr "重置"

msgid "До списку входять мовні пакети WordPress, встановлені на сайті, а також переклади, вбудовані в цей плагін."
msgstr "列表包含站点上已安装的 WordPress 语言包，以及内置于本插件中的翻译。"

msgid "Стан"
msgstr "状态"

msgid "Сторінка"
msgstr "页面"

msgid "Сумарно (хв)"
msgstr "总计（分钟）"

msgid "Сумарно по пристроях (хв)"
msgstr "按设备汇总（分钟）"

msgid "Сумарно по пристроях = сума активного часу кожного пристрою окремо."
msgstr "按设备汇总 = 每台设备各自活跃时间之和。"

msgid "Сусідні запити цього користувача (±15 хв)"
msgstr "该用户的相邻请求（±15 分钟）"

msgid "Таблиця:"
msgstr "数据表："

msgid "Тип"
msgstr "类型"

msgid "Тип запиту"
msgstr "请求类型"

msgid "Тип запиту:"
msgstr "请求类型："

msgid "Тип користувача:"
msgstr "用户类型："

msgid "Тільки адмінка та heartbeat"
msgstr "仅管理后台和 heartbeat"

msgid "Тільки для адміністраторів"
msgstr "仅限管理员"

msgid "Тільки для зареєстрованих користувачів"
msgstr "仅限已注册用户"

msgid "Тільки сайт без адмінки та heartbeat"
msgstr "仅网站前台（不含管理后台），及 heartbeat"

msgid "Тільки сторінки та heartbeat"
msgstr "仅页面和 heartbeat"

msgid "Увімкнути heartbeat (пінг, поки вкладка відкрита)"
msgstr "启用 heartbeat（标签页打开时发送 ping）"

