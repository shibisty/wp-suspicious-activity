msgstr "所选时间段内没有可用于构建时间线的数据。"

msgid "Низький"
msgstr "低"

msgid "Паралельна робота пристроїв: %s хв"
msgstr "设备并行使用：%s 分钟"

msgid "Паралельний час = Сумарно − Діапазон. Якщо > 0, пристрої працювали одночасно."
msgstr "并行时间 = 总计 − 范围。若 > 0，说明设备曾同时活动。"

msgid "Паралельно (хв)"
msgstr "并行（分钟）"

msgid "Параметри"
msgstr "参数"

msgid "Перевірте діагностику вище."
msgstr "请查看上方的诊断信息。"

msgid "Перегляд"
msgstr "查看"

msgid "Перегляд активності"
msgstr "活动详情"

msgid "Перегляд логу"
msgstr "日志详情"

msgid "Переглянути"
msgstr "查看"

