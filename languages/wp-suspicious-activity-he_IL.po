msgstr "אין נתונים לבניית ציר הזמן עבור התקופה שנבחרה."

msgid "Низький"
msgstr "נמוך"

msgid "Паралельна робота пристроїв: %s хв"
msgstr "עבודה מקבילה של מכשירים: %s דק'"

