msgstr "שעת היום של האתר. נתמך חלון זמן החוצה את חצות (למשל 22:00–06:00)."

msgid "Часова шкала"
msgstr "ציר זמן"

msgid "Шлях"
msgstr "נתיב"

msgid "Що логувати"
msgstr "מה לרשום"

msgid "Якщо розрив > 5 хв — користувач вийшов, розрив НЕ рахується."
msgstr "אם הפער > 5 דק' — המשתמש יצא, הפער לא נספר."

msgid "по"
msgstr "עד"

msgid "— мова сайту за замовчуванням —"
msgstr "— שפת ברירת המחדל של האתר —"

msgid "‹ Назад"
msgstr "‹ חזרה"

msgid "← До списку активності"
msgstr "← לרשימת הפעילות"

msgid "← До списку логів"
msgstr "← לרשימת היומנים"
