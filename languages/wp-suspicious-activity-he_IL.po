msgstr "סיכון"

msgid "Розрив (користувач вийшов)"
msgstr "פער (המשתמש יצא)"

msgid "Розрив: %s"
msgstr "פער: %s"

msgid "Розривів > 5 хв"
msgstr "פערים > 5 דק'"

msgid "Середній"
msgstr "בינוני"

msgid "Сесій"
msgstr "sessions"

msgid "Сесій: %d | Розривів > 5 хв: %d"
msgstr "Sessions: %d | פערים > 5 דק': %d"

msgid "Скинути"
msgstr "איפוס"

msgid "До списку входять мовні пакети WordPress, встановлені на сайті, а також переклади, вбудовані в цей плагін."
msgstr "הרשימה כוללת את חבילות השפה של WordPress המותקנות באתר, וכן תרגומים המובנים בתוסף זה."

msgid "Стан"
msgstr "מצב"

msgid "Сторінка"
msgstr "עמוד"

msgid "Сумарно (хв)"
msgstr "סה\"כ (דק')"

msgid "Сумарно по пристроях (хв)"
msgstr "סה\"כ לפי מכשירים (דק')"

