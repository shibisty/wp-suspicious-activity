msgid "1 пристрій"
msgstr "1 συσκευή"

msgid "2 пристрої"
msgstr "2 συσκευές"

msgid "3+ пристрої"
msgstr "3+ συσκευές"

msgid "API"
msgstr "API"

msgid "Email користувача:"
msgstr "Email χρήστη:"

msgid "Heartbeat"
msgstr "Heartbeat"

msgid "Heartbeat-запити забезпечують точний підрахунок часу, поки вкладка відкрита."
msgstr "Τα αιτήματα heartbeat εξασφαλίζουν ακριβή καταμέτρηση χρόνου όσο η καρτέλα είναι ανοιχτή."

msgid "ID запису"
msgstr "ID εγγραφής"

msgid "IP"
msgstr "IP"

msgid "IP-адреса"
msgstr "Διεύθυνση IP"

msgid "Session ID"
msgstr "ID συνεδρίας"

msgid "User-Agent"
msgstr "User-Agent"

msgid "Інтервал (сек)"
msgstr "Διάστημα (δευτ.)"

msgid "Адмінка"
msgstr "Περιοχή διαχείρισης"

msgid "Адміністратори"
msgstr "Διαχειριστές"

msgid "Активність"
msgstr "Δραστηριότητα"

msgid "Аудиторія"
msgstr "Κοινό"

msgid "Без паралельної активності"
msgstr "Χωρίς παράλληλη δραστηριότητα"

msgid "Високий"
msgstr "Υψηλός"

msgid "Вперед ›"
msgstr "Επόμενο ›"

msgid "Всього записів:"
msgstr "Σύνολο εγγραφών:"

msgid "Всі користувачі"
msgstr "Όλοι οι χρήστες"

msgid "Всі сторінки, API та адмінка (максимальна видимість)"
msgstr "Όλες οι σελίδες, το API και η περιοχή διαχείρισης (μέγιστη ορατότητα)"

msgid "Всі типи"
msgstr "Όλοι οι τύποι"

msgid "Гість"
msgstr "Επισκέπτης"

msgid "Дата від:"
msgstr "Ημερομηνία από:"

msgid "Дата до:"
msgstr "Ημερομηνία έως:"

msgid "Дата й час"
msgstr "Ημερομηνία και ώρα"

msgid "Детектор підозрілої активності"
msgstr "Ανιχνευτής ύποπτης δραστηριότητας"

msgid "Діагностика:"
msgstr "Διάγνωση:"

msgid "Діапазон (хв)"
msgstr "Εύρος (λεπτά)"

msgid "Діапазон = сума всіх активних проміжків (реальний час на сайті)."
msgstr "Εύρος = το άθροισμα όλων των ενεργών διαστημάτων (πραγματικός χρόνος στον ιστότοπο)."

msgid "Діапазон логування"
msgstr "Εύρος καταγραφής"

msgid "Дії"
msgstr "Ενέργειες"

msgid "З"
msgstr "Από"

msgid "За вказаними критеріями даних не знайдено."
msgstr "Δεν βρέθηκαν δεδομένα για τα καθορισμένα κριτήρια."

msgid "За вказаними критеріями записів не знайдено."
msgstr "Δεν βρέθηκαν εγγραφές για τα καθορισμένα κριτήρια."

msgid "За період:"
msgstr "Για την περίοδο:"

msgid "Завжди"
msgstr "Πάντα"

msgid "Запис не знайдено."
msgstr "Η εγγραφή δεν βρέθηκε."

msgid "Запити"
msgstr "Αιτήματα"

msgid "Запити сортуються по часу. Якщо розрив між сусідніми запитами ≤ 5 хв — це одна сесія, час додається."
msgstr "Τα αιτήματα ταξινομούνται κατά ώρα. Αν το κενό μεταξύ διαδοχικών αιτημάτων είναι ≤ 5 λεπτά, θεωρείται μία συνεδρία και ο χρόνος προστίθεται."

msgid "Зареєстровані"
msgstr "Εγγεγραμμένοι"

msgid "Застосувати фільтри"
msgstr "Εφαρμογή φίλτρων"

msgid "Зберегти налаштування"
msgstr "Αποθήκευση ρυθμίσεων"

msgid "Збільшити"
msgstr "Μεγέθυνση"

msgid "Зменшити"
msgstr "Σμίκρυνση"

msgid "Знайдено записів:"
msgstr "Εγγραφές που βρέθηκαν:"

msgid "Знайдено користувачів:"
msgstr "Χρήστες που βρέθηκαν:"

msgid "Коли логувати"
msgstr "Πότε να καταγράφεται"

msgid "Користувач"
msgstr "Χρήστης"

msgid "Користувача не вказано."
msgstr "Δεν καθορίστηκε χρήστης."

msgid "Коротке перетинання: %s хв"
msgstr "Σύντομη επικάλυψη: %s λεπτά"

msgid "Курси"
msgstr "Μαθήματα"

msgid "Лог запитів"
msgstr "Αρχείο καταγραφής αιτημάτων"

msgid "Логи"
msgstr "Αρχεία καταγραφής"

msgid "Логувати для всіх (включно з гостями)"
msgstr "Καταγραφή για όλους (συμπεριλαμβανομένων των επισκεπτών)"

msgid "Логіка підрахунку часу (сесійний метод):"
msgstr "Λογική υπολογισμού χρόνου (μέθοδος συνεδρίας):"

msgid "Мова"
msgstr "Γλώσσα"

msgid "Мова інтерфейсу плагіна"
msgstr "Γλώσσα διεπαφής του πρόσθετου"

msgid "Мін. унікальних IP:"
msgstr "Ελάχ. μοναδικές IP:"

msgid "Налаштування"
msgstr "Ρυθμίσεις"

msgid "Налаштування збережено."
msgstr "Οι ρυθμίσεις αποθηκεύτηκαν."

msgid "Налаштування підозрілої активності"
msgstr "Ρυθμίσεις ύποπτης δραστηριότητας"

msgid "Неактивний"
msgstr "Ανενεργός"

msgid "Недостатньо даних"
msgstr "Ανεπαρκή δεδομένα"

msgid "Недостатньо прав"
msgstr "Ανεπαρκή δικαιώματα"

msgid "Немає даних для побудови таймлайну за обраний період."
msgstr "Δεν υπάρχουν δεδομένα για τη δημιουργία χρονολογίου για την επιλεγμένη περίοδο."

msgid "Низький"
msgstr "Χαμηλός"

msgid "Паралельна робота пристроїв: %s хв"
msgstr "Παράλληλη χρήση συσκευών: %s λεπτά"

msgid "Паралельний час = Сумарно − Діапазон. Якщо > 0, пристрої працювали одночасно."
msgstr "Παράλληλος χρόνος = Σύνολο − Εύρος. Αν > 0, οι συσκευές ήταν ενεργές ταυτόχρονα."

msgid "Паралельно (хв)"
msgstr "Παράλληλα (λεπτά)"

msgid "Параметри"
msgstr "Παράμετροι"

msgid "Перевірте діагностику вище."
msgstr "Ελέγξτε τη διάγνωση παραπάνω."

msgid "Перегляд"
msgstr "Προβολή"

msgid "Перегляд активності"
msgstr "Προβολή δραστηριότητας"

msgid "Перегляд логу"
msgstr "Προβολή εγγραφής"

msgid "Переглянути"
msgstr "Προβολή"

msgid "Перестати логувати"
msgstr "Διακοπή καταγραφής"

msgid "Період"
msgstr "Περίοδος"

msgid "Показати всі логи цього користувача"
msgstr "Εμφάνιση όλων των αρχείων αυτού του χρήστη"

msgid "Показати ▼"
msgstr "Εμφάνιση ▼"

msgid "Помилка SQL:"
msgstr "Σφάλμα SQL:"

msgid "Пристрої"
msgstr "Συσκευές"

msgid "Пристрої працювали одночасно"
msgstr "Οι συσκευές ήταν ενεργές ταυτόχρονα"

msgid "Пристрій"
msgstr "Συσκευή"

msgid "Пристрій (User-Agent містить):"
msgstr "Συσκευή (το User-Agent περιέχει):"

msgid "Проміжок часу"
msgstr "Χρονικό παράθυρο"

msgid "Підозріла активність"
msgstr "Ύποπτη δραστηριότητα"

msgid "Результатів запиту:"
msgstr "Αποτελέσματα ερωτήματος:"

msgid "Ризик"
msgstr "Κίνδυνος"

msgid "Розрив (користувач вийшов)"
msgstr "Κενό (ο χρήστης έφυγε)"

msgid "Розрив: %s"
msgstr "Κενό: %s"

msgid "Розривів > 5 хв"
msgstr "Κενά > 5 λεπτά"

msgid "Середній"
msgstr "Μεσαίος"

msgid "Сесій"
msgstr "Συνεδρίες"

msgid "Сесій: %d | Розривів > 5 хв: %d"
msgstr "Συνεδρίες: %d | Κενά > 5 λεπτά: %d"

msgid "Скинути"
msgstr "Επαναφορά"

msgid "До списку входять мовні пакети WordPress, встановлені на сайті, а також переклади, вбудовані в цей плагін."
msgstr "Η λίστα περιλαμβάνει τα γλωσσικά πακέτα του WordPress που είναι εγκατεστημένα στον ιστότοπο, καθώς και τις μεταφράσεις που είναι ενσωματωμένες σε αυτό το πρόσθετο."

msgid "Стан"
msgstr "Κατάσταση"

msgid "Сторінка"
msgstr "Σελίδα"

msgid "Сумарно (хв)"
msgstr "Σύνολο (λεπτά)"

msgid "Сумарно по пристроях (хв)"
msgstr "Σύνολο ανά συσκευή (λεπτά)"

msgid "Сумарно по пристроях = сума активного часу кожного пристрою окремо."
msgstr "Σύνολο ανά συσκευή = το άθροισμα του ενεργού χρόνου κάθε συσκευής ξεχωριστά."

msgid "Сусідні запити цього користувача (±15 хв)"
msgstr "Γειτονικά αιτήματα αυτού του χρήστη (±15 λεπτά)"

msgid "Таблиця:"
msgstr "Πίνακας:"

msgid "Тип"
msgstr "Τύπος"

msgid "Тип запиту"
msgstr "Τύπος αιτήματος"

msgid "Тип запиту:"
msgstr "Τύπος αιτήματος:"

msgid "Тип користувача:"
msgstr "Τύπος χρήστη:"

msgid "Тільки адмінка та heartbeat"
msgstr "Μόνο περιοχή διαχείρισης και heartbeat"

msgid "Тільки для адміністраторів"
msgstr "Μόνο για διαχειριστές"

msgid "Тільки для зареєстрованих користувачів"
msgstr "Μόνο για εγγεγραμμένους χρήστες"

msgid "Тільки сайт без адмінки та heartbeat"
msgstr "Μόνο ο ιστότοπος, χωρίς την περιοχή διαχείρισης, και heartbeat"

msgid "Тільки сторінки та heartbeat"
msgstr "Μόνο σελίδες και heartbeat"

msgid "Увімкнути heartbeat (пінг, поки вкладка відкрита)"
msgstr "Ενεργοποίηση heartbeat (ping όσο η καρτέλα είναι ανοιχτή)"

msgid "Унікальних user_id:"
msgstr "Μοναδικά user_id:"

msgid "Хто підпадає під логування"
msgstr "Ποιοι καταγράφονται"

msgid "Час"
msgstr "Ώρα"

msgid "Час доби сайту. Проміжок, що перетинає північ (напр. 22:00–06:00), підтримується."
msgstr "Ώρα ημέρας του ιστότοπου. Υποστηρίζεται παράθυρο που διασχίζει τα μεσάνυχτα (π.χ. 22:00–06:00)."

msgid "Часова шкала"
msgstr "Χρονολόγιο"

msgid "Шлях"
msgstr "Διαδρομή"

msgid "Що логувати"
msgstr "Τι να καταγράφεται"

msgid "Якщо розрив > 5 хв — користувач вийшов, розрив НЕ рахується."
msgstr "Αν το κενό είναι > 5 λεπτά, ο χρήστης έφυγε και το κενό ΔΕΝ υπολογίζεται."

msgid "по"
msgstr "έως"

msgid "— мова сайту за замовчуванням —"
msgstr "— προεπιλεγμένη γλώσσα ιστότοπου —"

msgid "‹ Назад"
msgstr "‹ Πίσω"

msgid "← До списку активності"
msgstr "← Πίσω στη λίστα δραστηριότητας"

msgid "← До списку логів"
msgstr "← Πίσω στη λίστα αρχείων καταγραφής"
