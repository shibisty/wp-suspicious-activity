msgstr "Solo para administradores"

msgid "Тільки для зареєстрованих користувачів"
msgstr "Solo para usuarios registrados"

msgid "Тільки сайт без адмінки та heartbeat"
msgstr "Solo el sitio, sin administración, y heartbeat"

msgid "Тільки сторінки та heartbeat"
msgstr "Solo páginas y heartbeat"

